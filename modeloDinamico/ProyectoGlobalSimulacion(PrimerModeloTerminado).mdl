{UTF-8}
Salida Riego Potre=MIN(Potrerillos Demanda Riego, MAX(0, Potrerillos Caudal Regulado \
		* (1 - Potrerillos Prioridad Energia)))
	~	
	~		|

Agua Del Toro Salida Energia=MAX(0, Agua Del Toro Caudal Regulado - Agua Del Toro Salida Riego\
		)
	~	hm3/mes
	~		|

Agua Del Toro Caudal Regulado=MIN(Agua Del Toro Disponible, MAX(0, Agua Del Toro Entrada Agua\
		 + (Agua Del Toro Porcentaje Capacidad - 0.65) * 40))
	~	
	~	Embalse en 65% (objetivo): libera exactamente el caudal entrante
		Embalse en 90% (muy lleno): libera hasta 50 hm³ extra para hacer espacio
		Embalse en 40% (bajo): libera hasta 50 hm³ menos para conservar agua
	|

Nihuil Caudal Regulado=MIN ( Nihuil Disponible , MAX ( 0 , Nihuil Entrada Agua+(Nihuil Porcentaje Capacidad\
		-0.65)*30) )
	~	
	~	Embalse en 65% (objetivo): libera exactamente el caudal entrante
		Embalse en 90% (muy lleno): libera hasta 50 hm³ extra para hacer espacio
		Embalse en 40% (bajo): libera hasta 50 hm³ menos para conservar agua
	|

Salida Energia Potrerillos=MAX(0, Potrerillos Caudal Regulado - Salida Riego Potre)
	~	hm3/mes
	~	Agua turbinada en la central hidroeléctrica de Potrerillos (315 MW \
		instalados). Es lo que queda disponible después de satisfacer riego, \
		limitado por la fracción de prioridad energética.
	|

Potrerillos Caudal Regulado=MIN ( Potrerillos Disponible , MAX ( 0 , Entrada Agua Potrerillos\
		+(Potrerillos Porcentaje Capacidad-0.65)*200) )
	~	
	~	Embalse en 65% (objetivo): libera exactamente el caudal entrante
		Embalse en 90% (muy lleno): libera hasta 50 hm³ extra para hacer espacio
		Embalse en 40% (bajo): libera hasta 50 hm³ menos para conservar agua
	|

Agua Del Toro Entrada Agua = WITH LOOKUP (Mes Actual,
		([(0,35)-(11,125)],
		   (0,95),(1,110),(2,90),(3,70),(4,55),(5,45),
		   (6,40),(7,48),(8,68),(9,88),(10,110),(11,120)))
	~	hm3/mes
	~		|

Nihuil Entrada Agua = WITH LOOKUP (Mes Actual,
		([(0,25)-(11,100)],
		   (0,80),(1,90),(2,70),(3,55),(4,45),(5,35),
		   (6,30),(7,38),(8,55),(9,70),(10,88),(11,95)))
	~	hm3/mes
	~		|

Carrizal Salida Riego=MIN(Carrizal Demanda Riego, MAX(0, Carrizal Caudal Regulado * (\
		1 - Carrizal Prioridad Energia)))
	~	hm3/mes
	~		|

Carrizal Caudal Regulado=MIN(Carrizal Disponible, MAX(0, Carrizal Entrada Agua + (Carrizal Porcentaje Capacidad\
		 - 0.65) * 25))
	~	
	~	Embalse en 65% (objetivo): libera exactamente el caudal entrante
		Embalse en 90% (muy lleno): libera hasta 50 hm³ extra para hacer espacio
		Embalse en 40% (bajo): libera hasta 50 hm³ menos para conservar agua
	|

Entrada Agua Potrerillos = WITH LOOKUP (Mes Actual,
		([(0,100)-(11,400)],
		   (0,300),(1,350),(2,280),(3,220),(4,170),(5,140),
		   (6,120),(7,130),(8,180),(9,240),(10,320),(11,370)))
	~	hm3/mes
	~		|

Nihuil Salida Riego=MIN(Nihuil Demanda Riego, MAX(0, Nihuil Caudal Regulado * (1 - Nihuil Prioridad Energia\
		)))
	~	hm3/mes
	~		|

Agua Del Toro Salida Riego=MIN(Agua Del Toro Demanda Riego, MAX(0, Agua Del Toro Caudal Regulado\
		 * (1 - Agua Del Toro Prioridad Energia)))
	~	hm3/mes
	~		|

Carrizal Entrada Agua = WITH LOOKUP (Mes Actual,
		 ([(0,20)-(11,85)],
		   (0,65),(1,75),(2,60),(3,48),(4,35),(5,28),
		   (6,25),(7,30),(8,45),(9,60),(10,75),(11,80)))
	~	hm3/mes
	~		|

Carrizal Salida Energia=MAX(0, Carrizal Caudal Regulado - Carrizal Salida Riego)
	~	hm3/mes
	~	Agua turbinada en la central hidroeléctrica de Potrerillos (315 MW \
		instalados). Es lo que queda disponible después de satisfacer riego, \
		limitado por la fracción de prioridad energética.
	|

Nihuil Salida Energia=MAX(0, Nihuil Caudal Regulado - Nihuil Salida Riego)
	~	hm3/mes
	~	Agua turbinada en la central hidroeléctrica de Potrerillos (315 MW \
		instalados). Es lo que queda disponible después de satisfacer riego, \
		limitado por la fracción de prioridad energética.
	|

Agua Del Toro Cabeza Neta=60+120*Agua Del Toro Porcentaje Capacidad
	~	m
	~	Energía hidráulica real y efectiva de Agua del Toro disponible para \
		generar electricidad. Mínimo 60 m, máximo 180 m.
	|

Agua Del Toro Cap Max=380
	~	hm3
	~	Capacidad máxima del embalse Agua Del Toro.
	|

Agua Del Toro Consumo Urbano=3
	~	hm3/mes
	~	Consumo urbano de General Alvear y zona del Diamante.
	|

Agua Del Toro Demanda Riego = WITH LOOKUP (Mes Actual,
		([(0,27)-(11,97)],
		   (0,84),(1,92),(2,88),(3,59),(4,34),(5,29),
		   (6,29),(7,42),(8,67),(9,84),(10,96),(11,88)))
	~	hm3/mes
	~	Demanda estacional de riego del oasis del Tunuyán (zona Este de Mendoza, \
		viticultura y fruticultura).
	|

Agua Del Toro Disponible=MAX ( 0 , Agua Del Toro Volumen Embalse - Agua Del Toro Vol Min\
		 )
	~	hm3
	~	Agua realmente disponible para erogar (total menos el volumen muerto). \
		Garantiza que el embalse nunca quede completamente vacío.
	|

Agua Del Toro Evaporacion=Tasa Evap Mensual*0.6
	~	hm3/mes
	~	Pérdida por evaporación superficial. Factor 0.6 por alta altitud (menor \
		temperatura real que el promedio de Mendoza).
	|

Agua Del Toro Generacion GWh=Agua Del Toro Salida Energia*0.002314 *Agua Del Toro Cabeza Neta
	~	GWh/mes
	~	Energía generada mensualmente. Fórmula hidráulica: Potencia [kW] = 9.81 \
		× Q[m³/s] × H[m]. Convertida a GWh.Alta montaña = mayor altura de \
		caída = más eficiencia energética.
	|

Agua Del Toro Porcentaje Capacidad=Agua Del Toro Volumen Embalse/Agua Del Toro Cap Max
	~	dmnl
	~	Porcentaje de llenado (0 a 1). Es la variable de entrada del algoritmo de \
		decisión. Cuando es bajo, priorizar riego; cuando es alto, priorizar \
		energía.
	|

Agua Del Toro Prioridad Energia=IF THEN ELSE(Agua Del Toro Porcentaje Capacidad > 0.8\
		, 0.5,
	  IF THEN ELSE(Agua Del Toro Porcentaje Capacidad < 0.4, 0.1, 0.35))
	~	dmnl
	~	Embalse > 80% → balance con algo de energía (0.50)
		Embalse entre 40% y 80% → balance moderado (0.35)
		Embalse < 40% → prioridad al riego (0.10)
		Valores similares al Nihuil: sirve a 81.400 ha de cultivos mixtos (35% \
		viñas, 41% frutales).
	|

Agua Del Toro Satisfaccion Riego=Agua Del Toro Salida Riego/MAX ( 0.01 , Agua Del Toro Demanda Riego\
		 )
	~	dmnl
	~	Fracción de la demanda de riego satisfecha. 1.0 = todos los agricultores \
		reciben toda el agua que necesitan. Valores < 0.7 indican situación \
		crítica para el sector agropecuario.
	|

Agua Del Toro Vol Inicial=240
	~	hm3
	~	Volumen al inicio de la simulación
	|

Agua Del Toro Vol Min=40
	~	hm3
	~	Volumen mínimo operacional (muerto). No se puede erogar por debajo de \
		este nivel.
	|

Agua Del Toro Volumen Embalse= INTEG (Agua Del Toro Entrada Agua-Agua Del Toro Consumo Urbano\
		-Agua Del Toro Evaporacion-Agua Del Toro Salida Energia-Agua Del Toro Salida Riego,
		Agua Del Toro Vol Inicial)
	~	hm3
	~	Volumen de agua almacenado en Agua Del Toro en cada instante de la \
		simulación. Aumenta únicamente con Pot_Entrada (que viene del CSV de \
		Python). Disminuye por las 4 salidas. Es el corazón del modelo para este \
		embalse.
	|

Carrizal Cabeza Neta=30+70*Carrizal Porcentaje Capacidad
	~	m
	~	Energía hidráulica real y efectiva del Carrizal disponible para generar \
		electricidad. Mínimo 30 m, máximo 100 m.
	|

Carrizal Cap Max=195
	~	hm3
	~	Capacidad máxima del embalse Carrizal.
	|

Carrizal Consumo Urbano=2
	~	hm3/mes
	~	Consumo urbano de Tunuyán y alrededores.
	|

Carrizal Demanda Riego = WITH LOOKUP (Mes Actual,
		([(0,15)-(11,60)],
		   (0,50),(1,55),(2,52),(3,35),(4,20),(5,17),
		   (6,17),(7,25),(8,40),(9,50),(10,58),(11,52)))
	~	hm3/mes
	~	Demanda estacional de riego del oasis del Tunuyán (zona Este de Mendoza, \
		viticultura y fruticultura).
	|

Carrizal Disponible=MAX ( 0 , Carrizal Volumen Embalse - Carrizal Vol Min )
	~	hm3
	~	Agua realmente disponible para erogar (total menos el volumen muerto). \
		Garantiza que el embalse nunca quede completamente vacío.
	|

Carrizal Evaporacion=Tasa Evap Mensual*0.8
	~	hm3/mes
	~	Pérdida por evaporación superficial. Factor 0.8 por superficie menor del \
		Carrizal.
	|

Carrizal Generacion GWh=Carrizal Salida Energia*0.002314 *Carrizal Cabeza Neta
	~	GWh/mes
	~	Energía generada mensualmente. Fórmula hidráulica: Potencia [kW] = 9.81 \
		× Q[m³/s] × H[m]. Convertida a GWh.
	|

Carrizal Porcentaje Capacidad=Carrizal Volumen Embalse/Carrizal Cap Max
	~	dmnl
	~	Porcentaje de llenado (0 a 1). Es la variable de entrada del algoritmo de \
		decisión. Cuando es bajo, priorizar riego; cuando es alto, priorizar \
		energía.
	|

Carrizal Prioridad Energia=IF THEN ELSE(Carrizal Porcentaje Capacidad > 0.8, 0.3,
	  IF THEN ELSE(Carrizal Porcentaje Capacidad < 0.4, 0.05, 0.2))
	~	dmnl
	~	Embalse > 80% → puede ceder algo a energía (0.30)
		Embalse entre 40% y 80% → preferencia por riego (0.20)
		Embalse < 40% → casi todo para riego (0.05)
		El Carrizal tiene los valores más bajos de prioridad energética porque \
		abastece 4.302 km de canales de riego agrícola del oasis del Tunuyán.
	|

Carrizal Satisfaccion Riego=Carrizal Salida Riego/MAX ( 0.01 , Carrizal Demanda Riego\
		 )
	~	dmnl
	~	Fracción de la demanda de riego satisfecha. 1.0 = todos los agricultores \
		reciben toda el agua que necesitan. Valores < 0.7 indican situación \
		crítica para el sector agropecuario.
	|

Carrizal Vol Inicial=120
	~	hm3
	~	Volumen al inicio de la simulación
	|

Carrizal Vol Min=20
	~	hm3
	~	Volumen mínimo operacional (muerto). No se puede erogar por debajo de \
		este nivel.
	|

Carrizal Volumen Embalse= INTEG (Carrizal Entrada Agua-Carrizal Consumo Urbano-Carrizal Evaporacion\
		-Carrizal Salida Energia-Carrizal Salida Riego,
		Carrizal Vol Inicial)
	~	hm3
	~	Volumen de agua almacenado en Carrizal en cada instante de la simulación. \
		Aumenta únicamente con Pot_Entrada (que viene del CSV de Python). \
		Disminuye por las 4 salidas. Es el corazón del modelo para este embalse.
	|

Consumo Urbano Potrerillos=8
	~	hm3/mes
	~	Agua potable para el Gran Mendoza (Capital, Godoy Cruz, Guaymallén, Las \
		Heras, Maipú). Constante: 8 hm³/mes ≈ 96 hm³/año.
	|

Conviene Energia=IF THEN ELSE(Decision Sistema >= 0.5, 1, 0)
	~	dmnl
	~	dmnl (1=sí · 0=no)
		Vale 1 cuando la respuesta es "priorizar la energía". Siempre \
		complementario a Conviene_Riego: uno vale 1 y el otro vale 0.
	|

Conviene Riego=IF THEN ELSE (Decision Sistema < 0.5, 1, 0)
	~	dmnl
	~	dmnl (1=sí · 0=no)
		Vale 1 cuando la respuesta a la pregunta de investigación es "priorizar \
		el riego". Directamente legible en el gráfico de resultados.
	|

Crisis Hidrica=IF THEN ELSE ( Total Porcentaje de Llenado Completo<0.3 , 1 , 0 )
	~	dmnl
	~	dmnl (0=normal, 1=crisis)
		Se activa cuando el sistema cae por debajo del 30% de su capacidad total. \
		Permite contar cuántos meses de crisis ocurren en los años simulados.
	|

Decision Sistema=IF THEN ELSE(Total Porcentaje de Llenado Completo < 0.3, 0,
	  IF THEN ELSE(Total Porcentaje de Llenado Completo < 0.5, 0.25,
	  IF THEN ELSE(Total Porcentaje de Llenado Completo < 0.7, 0.5, 0.8)))
	~	dmnl
	~	Responde directamente la pregunta de investigación según el estado del sistema:
		
		0.00 → Sistema en crisis: TODO para riego, suspender energía
		0.25 → Sistema en alerta: preferencia fuerte por riego
		0.50 → Sistema normal: balance equitativo
		0.80 → Sistema holgado: priorizar energía (genera ingresos)
	|

Eficiencia Riego=0.6
	~	
	~		|

Evaporacion Potrerillos=Tasa Evap Mensual*1.4
	~	hm3/mes
	~	Pérdida por evaporación superficial. El factor 1.4 refleja que \
		Potrerillos tiene el espejo de agua más grande del sistema ( 28 km² a \
		plena capacidad).
	|

Mes Actual=MODULO ( Time , 12 )
	~	Month
	~	Devuelve el mes actual (0=Enero, 1=Feb, ..., 11=Dic). Es la clave para \
		tablas estacionales.
	|

Nihuil Cabeza Neta=40+110*Nihuil Porcentaje Capacidad
	~	m
	~	Energía hidráulica real y efectiva del Nihuil disponible para generar \
		electricidad. Mínimo 40 m, máximo 150 m.
	|

Nihuil Cap Max=320
	~	hm3
	~	Capacidad máxima del embalse Nihuil.
	|

Nihuil Consumo Urbano =2
	~	hm3/mes
	~	Consumo urbano de San Rafael (zona Atuel).
	|

Nihuil Demanda Riego = WITH LOOKUP (Mes Actual,
		([(0,20)-(11,75)],
		   (0,65),(1,71),(2,68),(3,45),(4,26),(5,22),
		   (6,22),(7,32),(8,52),(9,65),(10,74),(11,68)))
	~	hm3/mes
	~	Demanda estacional de riego del oasis del Atuel (San Rafael). Cultivos \
		mixtos de viñedos y frutales en la zona sur de Mendoza.
	|

Nihuil Disponible=MAX ( 0 , Nihuil Volumen Embalse - Nihuil Vol Min )
	~	hm3
	~	Agua realmente disponible para erogar (total menos el volumen muerto). \
		Garantiza que el embalse nunca quede completamente vacío.
	|

Nihuil Evaporacion=Tasa Evap Mensual*0.9
	~	hm3/mes
	~	Pérdida por evaporación superficial. Factor 0.9 por superficie \
		intermedia del Nihuil.
	|

Nihuil Generacion GWh=Nihuil Salida Energia*0.002314*Nihuil Cabeza Neta
	~	GWh/mes
	~	Energía generada mensualmente. Fórmula hidráulica: Potencia [kW] = 9.81 \
		× Q[m³/s] × H[m]. Convertida a GWh.
	|

Nihuil Porcentaje Capacidad=Nihuil Volumen Embalse/Nihuil Cap Max
	~	dmnl
	~	Porcentaje de llenado (0 a 1). Es la variable de entrada del algoritmo de \
		decisión. Cuando es bajo, priorizar riego; cuando es alto, priorizar \
		energía.
	|

Nihuil Prioridad Energia=IF THEN ELSE(Nihuil Porcentaje Capacidad > 0.8, 0.5,
	  IF THEN ELSE(Nihuil Porcentaje Capacidad < 0.4, 0.1, 0.35))
	~	dmnl
	~	Embalse > 80% → balance moderado con algo de energía (0.50)
		Embalse entre 40% y 80% → ligera preferencia por riego (0.35)
		Embalse < 40% → prioridad al riego (0.10)
		El Nihuil tiene valores intermedios porque sirve a agricultores del Atuel \
		pero también genera energía.
	|

Nihuil Satisfaccion Riego=Nihuil Salida Riego/MAX ( 0.01 , Nihuil Demanda Riego )
	~	dmnl
	~	Fracción de la demanda de riego satisfecha. 1.0 = todos los agricultores \
		reciben toda el agua que necesitan. Valores < 0.7 indican situación \
		crítica para el sector agropecuario.
	|

Nihuil Vol Inicial=200
	~	hm3
	~	Volumen al inicio de la simulación
	|

Nihuil Vol Min=100
	~	hm3
	~	Volumen mínimo operacional (muerto). No se puede erogar por debajo de \
		este nivel.
	|

Nihuil Volumen Embalse= INTEG (Nihuil Entrada Agua-Nihuil Consumo Urbano-Nihuil Evaporacion\
		-Nihuil Salida Energia-Nihuil Salida Riego,
		Nihuil Vol Inicial)
	~	hm3
	~	Volumen de agua almacenado en Nihuil en cada instante de la simulación. \
		Aumenta únicamente con Pot_Entrada (que viene del CSV de Python). \
		Disminuye por las 4 salidas. Es el corazón del modelo para este embalse.
	|

Potrerillos Cabeza Neta=150+200*Potrerillos Porcentaje Capacidad
	~	m
	~	Energía hidráulica real y efectiva de Potrerillos disponible para \
		generar electricidad. Mínimo 40 m, máximo 150 m. Mínimo 150 m (embalse \
		casi vacío), máximo 350 m (embalse lleno). Rango realista para una \
		central de 315 MW.
	|

Potrerillos Cap Max=1885
	~	hm3
	~	Capacidad máxima del embalse Potrerillos.
	|

Potrerillos Demanda Riego = WITH LOOKUP (Mes Actual,
		([(0,80)-(11,300)],
		   (0,250),(1,275),(2,262),(3,175),(4,100),(5,87),
		   (6,87),(7,125),(8,200),(9,250),(10,287),(11,262)))
	~	hm3/mes
	~	Demanda estacional de riego del oasis norte (Lavalle, Las Heras, Maipú, \
		Luján de Cuyo, Godoy Cruz). Máxima en verano (cultivos en crecimiento), \
		mínima en invierno. Esta tabla es DETERMINÍSTICA — la aleatoriedad de \
		la oferta viene de Python, la demanda sigue un patrón conocido.
	|

Potrerillos Disponible=MAX ( 0 , Volumen Embalse Potrerillos - Potrerillos Vol Min )
	~	hm3
	~	Agua realmente disponible para erogar (total menos el volumen muerto). \
		Garantiza que el embalse nunca quede completamente vacío.
	|

Potrerillos Generacion GWh=Salida Energia Potrerillos*0.002314 *Potrerillos Cabeza Neta
	~	GWh/mes
	~	Energía generada mensualmente. Fórmula hidráulica: Potencia [kW] = 9.81 \
		× Q[m³/s] × H[m]. Convertida a GWh. A plena capacidad Potrerillos puede \
		generar  220 GWh/mes.
	|

Potrerillos Porcentaje Capacidad=Volumen Embalse Potrerillos/Potrerillos Cap Max
	~	dmnl
	~	Porcentaje de llenado (0 a 1). Es la variable de entrada del algoritmo de \
		decisión. Cuando es bajo, priorizar riego; cuando es alto, priorizar \
		energía.
	|

Potrerillos Prioridad Energia=IF THEN ELSE(Potrerillos Porcentaje Capacidad > 0.8, 0.8\
		,
	  IF THEN ELSE(Potrerillos Porcentaje Capacidad < 0.4, 0.15, 0.5))
	~	dmnl
	~	Embalse > 80% → priorizar energía fuertemente (0.80)
		Embalse entre 40% y 80% → balance (0.50)
		Embalse < 40% → priorizar riego urgentemente (0.15)
		Potrerillos tiene los valores más altos porque es la principal fuente \
		hidroeléctrica de Mendoza.
	|

Potrerillos Satisfaccion Riego=Salida Riego Potre/MAX ( 0.01 , Potrerillos Demanda Riego\
		 )
	~	dmnl
	~	Fracción de la demanda de riego satisfecha. 1.0 = todos los agricultores \
		reciben toda el agua que necesitan. Valores < 0.7 indican situación \
		crítica para el sector agropecuario.
	|

Potrerillos Vol Inicial=1200
	~	hm3
	~	Volumen al inicio de la simulación
	|

Potrerillos Vol Min=100
	~	hm3
	~	olumen mínimo operacional (muerto). No se puede erogar por debajo de este \
		nivel.
	|

Precio MWh=80
	~	
	~	Precio promedio de venta de energía eléctrica en el mercado mayorista \
		argentino
	|

Tasa Evap Mensual=MAX ( 0 , (Temperatura Actual-5)*0.05 )
	~	hm3/mes
	~	 Evaporación base del sistema. Mendoza tiene clima árido con alta \
		evapotranspiración potencial. A 25°C: (25-5)*0.05 = 1 hm³/mes por \
		embalse.
	|

Temperatura Actual=20+8*SIN ( 2 * 3.14159 * Time / 12 )
	~	°C
	~	Ciclo anual de temperatura. Pico en enero ( 28°C), mínimo en julio ( \
		12°C). Representa el clima de Mendoza.
	|

Total Capacidad Maxima=2780
	~	hm3
	~	1885 + 320 + 195 + 380 = 2.780 hm³. Capacidad total del sistema de los 4 \
		embalses simulados.
	|

Total Demanda Riego=Agua Del Toro Demanda Riego+Carrizal Demanda Riego+Nihuil Demanda Riego\
		+Potrerillos Demanda Riego
	~	hm3/m
	~	Demanda agrícola total del sistema. En enero puede superar los 680 \
		hm³/mes.
	|

Total Energia GWh=Agua Del Toro Generacion GWh+Carrizal Generacion GWh+Nihuil Generacion GWh\
		+Potrerillos Generacion GWh
	~	GWh/mes
	~	Energía eléctrica total generada por los 4 embalses.
	|

Total Ingresos Energia=Total Energia GWh*Precio MWh*1000
	~	USD/mes
	~	Ingresos mensuales por venta de energía eléctrica. La conversión ×1000 \
		transforma GWh a MWh para aplicar el precio unitario.
	|

Total Porcentaje de Llenado Completo=Total Volumen/Total Capacidad Maxima
	~	dmnl
	~	Porcentaje de llenado del sistema completo. Umbrales de interpretación:
		
		Mayor a 0.70 → Sistema holgado
		0.50 a 0.70 → Normal
		0.30 a 0.50 → Alerta hídrica
		Menor a 0.30 → Crisis hídrica
	|

Total Riego Entregado=(Agua Del Toro Salida Riego+Carrizal Salida Riego+Nihuil Salida Riego\
		+Salida Riego Potre)*Eficiencia Riego
	~	hm3/mes
	~	Agua que REALMENTE llega a los cultivos en toda Mendoza, descontando el \
		40% de pérdidas en la red de canales.
	|

Total Satisfaccion Riego=Total Riego Entregado/MAX ( 0.01 , Total Demanda Riego )
	~	dmnl
	~	Fracción de la demanda agrícola total que fue satisfecha. Es el \
		indicador de impacto social del modelo. Valor 1.0 = todos los agricultores \
		tienen el agua que necesitan.
	|

Total Volumen=Agua Del Toro Volumen Embalse+Carrizal Volumen Embalse+Nihuil Volumen Embalse\
		+Volumen Embalse Potrerillos
	~	hm3
	~	Agua total almacenada en el sistema en cada instante. Principal indicador \
		del estado hídrico general de Mendoza.
	|

Volumen Embalse Potrerillos= INTEG (Entrada Agua Potrerillos-Consumo Urbano Potrerillos\
		-Evaporacion Potrerillos-Salida Energia Potrerillos
	-Salida Riego Potre,
		Potrerillos Vol Inicial)
	~	hm3
	~	Volumen de agua almacenado en Potrerillos en cada instante de la \
		simulación. Aumenta únicamente con Pot_Entrada (que viene del CSV de \
		Python). Disminuye por las 4 salidas. Es el corazón del modelo para este \
		embalse.
	|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 120
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP 
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

